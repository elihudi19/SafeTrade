# Nakili faili hii kuwa .env kwa maendeleo ya ndani.
# Kwenye Render/AWS, weka hizi kama Environment Variables za platform - SIYO
# kwenye faili ya .env (usije uka-commit .env kwenye git kamwe).

DJANGO_SECRET_KEY=badilisha-hii-kuwa-random-string-ndefu
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Local dev (docker-compose). Render/AWS zitatoa DATABASE_URL zake wenyewe.
DATABASE_URL=postgres://safetrade:safetrade@db:5432/safetrade
DB_SSL_MODE=prefer

REDIS_URL=redis://redis:6379/0

# STORAGE_BACKEND=local kwa dev ya haraka bila S3.
# Kwa Render/AWS, tumia STORAGE_BACKEND=s3 daima (Render disk si ya kudumu).
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=af-south-1
AWS_S3_ENDPOINT_URL=

# --- NIDA (uthibitisho wa Owner kwa nida_number + phone_number) ---
# NIDA_MOCK_MODE=True kwa maendeleo ya ndani - inakagua MUUNDO wa namba
# pekee (siyo NIDA halisi). Weka False na credentials halisi kabla ya live.
NIDA_MOCK_MODE=True
NIDA_API_BASE_URL=
NIDA_API_KEY=

# --- SMS (OTP + digital receipts) ---
# Bila SMS_API_KEY, mfumo unaweka LOG pekee (stub) - inafaa kwa majaribio.
SMS_API_KEY=
SMS_SENDER_ID=SafeTrade

# --- Bolt (delivery) ---
BOLT_API_BASE_URL=
BOLT_API_KEY=
